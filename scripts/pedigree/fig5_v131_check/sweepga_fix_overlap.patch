+    /// Fraction of this mapping's query span covered by another mapping
+    pub fn query_covered_by(&self, other: &PlaneSweepMapping) -> f64 {
+        let len = (self.query_end - self.query_start) as f64;
+        let ov = (self.query_end.min(other.query_end) as i64 - self.query_start.max(other.query_start) as i64).max(0) as f64;
+        if len > 0.0 { ov / len } else { 0.0 }
+    }
+
