+/// Temporary switch: SWEEPGA_OVERLAP_MODE=candidate measures overlap over the candidate only
+fn overlap_relative_to_candidate() -> bool {
+    static MODE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *MODE.get_or_init(|| {
+        let on = std::env::var("SWEEPGA_OVERLAP_MODE").map(|v| v == "candidate").unwrap_or(false);
+        if on {
+            eprintln!("[sweepga] SWEEPGA_OVERLAP_MODE=candidate: overlap measured over the candidate mapping");
+        }
+        on
